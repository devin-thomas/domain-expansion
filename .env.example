# Public Firebase web configuration. These values identify the project in the browser.
# They are not Admin credentials and must not include a service-account private key.
VITE_FIREBASE_API_KEY="your-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-web-app-id"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"

# Optional integration-only Google OAuth client. Not used for Domain Expansion sign-in.
VITE_GOOGLE_OAUTH_CLIENT_ID="your-oauth-client.apps.googleusercontent.com"

# Server
APP_ENV="development"
APP_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://domains.devthomas.site"
AUTH_CONTINUE_URL="http://localhost:3000/auth/finish"
PORT="3000"
DATA_STORE="memory"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_WEB_API_KEY="your-web-api-key"
# FIREBASE_SERVICE_ACCOUNT_JSON is a server-only secret. Do not commit it or prefix it with VITE_.

# Trusted owner bootstrap. Never inferred from the first visitor.
OWNER_UID=""
OWNER_EMAIL=""
ADMIN_NOTIFICATION_EMAIL="you@example.com"
RESEND_API_KEY=""
RESEND_FROM="Domain Expansion <auth@devthomas.site>"
NOTIFICATION_RETRY_SECRET=""

# BYOK keyring: JSON map of key id to base64-encoded 32-byte AES keys. Server only.
BYOK_KEYRING=""
BYOK_KEY_ID=""
OWNER_GEMINI_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"

# HMAC secret for pagination cursors.
CURSOR_SECRET=""

# Shared Cloudflare Worker/Vercel server-only HMAC key: 32 random bytes as 64 hex characters.
# Required by the canonical API Worker. Never prefix it with VITE_.
EDGE_CLIENT_IP_SECRET=""

# Test-only session issuer. Refused when APP_ENV=production.
DOMAIN_EXPANSION_TEST_AUTH="0"
TEST_AUTH_SECRET=""
VITE_TEST_AUTH="0"
